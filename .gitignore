# Virtual environments
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Build / packaging
build/
dist/
*.egg-info/

# Tool caches
.pytest_cache/
.ruff_cache/
.pyrefly_cache/

# mutmut's working copy of the tree — it also holds the run's verdicts and timings, so this
# is the whole cache. `mise run mutate` deletes it before every run.
mutants/

# Secrets: telemetry backend ingest keys (see README.md)
.env

# Subagent → dispatcher handoffs (conventions: docs/handoffs.md). Per-run
# scratch, regenerable, and never a durable authority.
/handoffs/

# Claude Code agent worktrees — each is a full checkout; ignore so linters
# don't scan them
.claude/worktrees/

# Local-only Claude Code settings (permissions accumulated per machine)
.claude/settings.local.json

# Extracted telemetry and analysis scratch — raw session data can be large and
# contains whatever the agent read. Committed reports live in reports/.
/data/

# Cargo's build directory. `rust/Cargo.lock` is committed beside it: the workspace will build
# a binary, so the versions a build resolved are part of what the port's report rests on.
/rust/target/

# The browser tier's installed packages and what a run of it leaves behind. `mise run e2e-deps`
# puts the first back from the committed lockfile; the rest is a failed sweep's traces.
tests/e2e/node_modules/
tests/e2e/test-results/
tests/e2e/playwright-report/

.DS_Store
