{
  // Editor parity with `mise run format-html`: same binary, same `[tool.djlint]` in
  // `pyproject.toml`. Keep this file to what parity needs — the tasks live in `tasks.json`.
  //
  // The venv's djlint, which is the pinned one `check` runs. Already djLint's default;
  // written down because a future default flip would break the parity this file exists for.
  "djlint.useVenv": true,
  // Off. `indent` in `pyproject.toml` decides. Left on (the default) the extension passes the
  // editor's tab size instead, and on-save output stops matching `mise run format-html-check`.
  "djlint.useEditorIndentation": false,
  // Scoped to the two languages the templates are opened as, so no other file type inherits
  // a save hook.
  "[html]": {
    "editor.defaultFormatter": "monosans.djlint",
    "editor.formatOnSave": true
  },
  "[jinja-html]": {
    "editor.defaultFormatter": "monosans.djlint",
    "editor.formatOnSave": true
  }
}
